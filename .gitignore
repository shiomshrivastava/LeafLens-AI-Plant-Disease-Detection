# ============================================================
# LeafLens - Git ignore rules (React/Vite + FastAPI + ESP32)
# Keep source code, Supabase SQL/migrations and documentation.
# ============================================================

# Frontend - Node.js / Vite
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / FastAPI
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Credentials and environment files
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx
*service-account*.json
*credentials*.json

# Arduino / ESP32 - keep Wi-Fi passwords and device tokens private
**/secrets.h
**/wifi_secrets.h
**/credentials.h
**/config.private.h
# CURRENT LeafLens sketch has real network/device credentials.
# Do NOT track it until secrets are moved to an ignored header.
**/LeafLens_DHT11.ino

# Trained AI weights and local model assets (too large for ordinary Git)
backend/model_assets/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.keras
*.onnx
*.safetensors
*.tflite
*.joblib

# Datasets, generated uploads, reports and backups
/Dataset/
/dataset/
/datasets/
/FINAL_CLEAN_DATASET/
/data/
/uploads/
/tmp/
/temp/
/reports/
/backups/
*.zip
*.rar
*.7z
*.tar.gz

# Local caches, runtime databases and test output
.cache/
*.sqlite
*.sqlite3
*.db
playwright-report/
test-results/

# Supabase CLI local state (do not ignore supabase migrations/source)
supabase/.branches/
supabase/.temp/

# Editor and OS generated files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
