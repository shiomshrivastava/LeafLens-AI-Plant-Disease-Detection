# Backend ONLY. Save this as backend/.env (NEVER in frontend src or .env.local)
SUPABASE_URL=https://mbwxpaitaxmorpuyxfcr.supabase.co
# Copy from your existing frontend .env.local (publishable key, safe for browser)
SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_EXISTING_SB_PUBLISHABLE_KEY
# Get from Supabase dashboard > Project Settings > API Keys.
# Use a server-only secret key (sb_secret_...) or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_BACKEND_ONLY_SECRET_KEY

# Hybrid deployment (optional). Omit or use local to keep existing full app.
# LEAFLENS_BACKEND_MODE=local

# For a lightweight cloud API instance ONLY:
# LEAFLENS_BACKEND_MODE=cloud
# LEAFLENS_AI_WORKER_URL=https://YOUR-TAILSCALE-FUNNEL-HOSTNAME
# LEAFLENS_AI_WORKER_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET

# For the laptop AI worker, set only LEAFLENS_AI_WORKER_TOKEN to
# the SAME random secret as the cloud backend. Never use Supabase secrets
# as the worker token, and never place it in VITE_ variables.
